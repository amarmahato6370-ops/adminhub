# Environment variables

NEXT_PUBLIC_APP_NAME=Adminhub
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-secure-random-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adminhub
RESEND_API_KEY=replace-with-your-resend-key
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-your-access-key
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-key
AWS_S3_BUCKET=adminhub-dev
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=admin
SMTP_PASSWORD=admin
